{% set data = teaser or projectsTeaser %} {% if data %}
<!-- Proyectos teaser -->
<section class="py-24" id="{{ data.id }}">
  <div class="max-w-7xl mx-auto px-6">
    <article class="border border-slate-200 bg-white p-8 md:p-12">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold tracking-[0.18em] uppercase text-slate-500">{{ data.eyebrow }}</p>
        <h2 class="mt-3 font-display text-3xl md:text-4xl text-primary">{{ data.title }}</h2>
        <p class="mt-4 text-base text-slate-600 leading-relaxed">{{ data.description }}</p>
        <p class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-[0.12em] text-slate-500">
          <span class="inline-flex h-2 w-2 rounded-full bg-primary animate-pulse"></span>
          {{ data.status }}
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-5">
        {% for item in data.items %}
        <a
          href="{{ item.url }}"
          class="group flex h-full flex-col border border-slate-200 bg-slate-50 p-6 transition-all duration-200 hover:border-primary/40 hover:bg-white">
          <span class="material-icons text-primary" aria-hidden="true">{{ item.icon }}</span>
          <h3 class="mt-4 font-display text-lg text-primary">{{ item.title }}</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">{{ item.description }}</p>
          <span class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-primary">
            {{ item.ctaLabel }}
            <span class="material-icons text-base transition-transform group-hover:translate-x-1" aria-hidden="true"
              >arrow_forward</span
            >
          </span>
        </a>
        {% endfor %}
      </div>

      <div class="mt-10">
        <a class="btn btn-primary" href="{{ data.ctaUrl }}">
          {{ data.ctaLabel }}
          <span class="material-icons" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </article>
  </div>
</section>
{% endif %}
