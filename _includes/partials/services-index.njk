<section id="servicios-indice" class="scroll-mt-20 border-y border-slate-200 bg-slate-50">
  <div class="max-w-7xl mx-auto px-6 py-12 md:py-16">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <p class="text-xs font-semibold tracking-[0.18em] uppercase text-slate-500">Índice de servicios</p>
        <h2 class="mt-2 font-display text-2xl md:text-3xl text-primary">Seis servicios, una ruta de evolución</h2>
      </div>
      <p class="max-w-md text-sm text-slate-600 leading-relaxed md:text-right">
        Empieza por el diagnóstico o salta al bloque que responde a tu necesidad. Cada servicio es un módulo completo
        con entregables, beneficios y señales.
      </p>
    </div>

    <nav aria-label="Índice de los 6 servicios" class="mt-8">
      <ol class="grid grid-cols-1 border-l border-t border-slate-200 bg-white sm:grid-cols-2 lg:grid-cols-3">
        {% for s in serviceBlocks %}
        <li class="border-b border-r border-slate-200">
          <a
            href="#{{ s.id }}"
            class="group flex h-full items-start gap-4 p-5 transition-colors hover:bg-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary md:p-6">
            <span
              class="font-display text-2xl leading-none text-slate-500 transition-colors group-hover:text-white/70"
              aria-hidden="true">
              0{{ loop.index }}
            </span>
            <span class="min-w-0 flex-1">
              <span
                class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 transition-colors group-hover:text-white/70">
                {{ s.eyebrow }}
              </span>
              <span
                class="mt-1 block font-display text-lg leading-snug text-primary transition-colors group-hover:text-white">
                {{ s.title }}
              </span>
            </span>
            <span
              class="material-icons text-lg text-slate-500 transition-colors group-hover:text-white"
              aria-hidden="true">
              arrow_outward
            </span>
          </a>
        </li>
        {% endfor %}
      </ol>
    </nav>
  </div>
</section>
